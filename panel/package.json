{
  "name": "mlx-harness",
  "productName": "MLX Harness",
  "version": "0.5.2",
  "description": "MLX Harness: run, chat with and serve AI models locally on Apple Silicon. Built on vMLX by JANGQ AI.",
  "main": "dist/main/index.mjs",
  "author": "Flex UK Limited (MLX Network) <info@mlx.app>",
  "license": "Apache-2.0",
  "homepage": "https://harness.mlx.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MLXapp/harness.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "./scripts/bundle-python.sh && ./scripts/verify-bundled-python.sh && electron-vite build",
    "release:gate": "./scripts/release-gate-python-app.py",
    "release:ready": "cd .. && ${PYTHON:-.venv/bin/python} tests/cross_matrix/run_release_regression_manifest.py --require-release-ready --out build/current-release-regression-manifest-pre-panel-dist.json",
    "release:prepackage": "cd .. && ${PYTHON:-.venv/bin/python} tests/cross_matrix/run_release_regression_manifest.py --require-prepackage-ready --out build/current-release-regression-manifest-pre-panel-dist.json",
    "verify-bundled": "./scripts/verify-bundled-python.sh",
    "preview": "electron-vite preview",
    "preview:ui": "vite --config preview/vite.config.ts",
    "preview:build": "vite build --config preview/vite.config.ts",
    "preview:shot": "node scripts/preview-shot.mjs",
    "preview:typecheck": "tsc --noEmit -p preview/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "icons": "node generate-icons.js",
    "package": "npm run dist",
    "dist": "./scripts/build-harness-dmg.sh",
    "postinstall": "electron-builder install-app-deps",
    "dist:upstream": "VMLX_RELEASE_SCOPE=production ./scripts/build-release-dmgs.sh all"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.3.2",
    "katex": "^0.18.1",
    "lucide-react": "^0.577.0",
    "marked": "^12.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^1.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "44.3.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "playwright-core": "^1.60.0",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "app.mlx.studio",
    "productName": "MLX Harness",
    "copyright": "Copyright 2026 Flex UK Limited (MLX Network). Built on vMLX, Copyright 2026 JANGQ AI.",
    "beforePack": "scripts/electron-builder-before-pack.cjs",
    "afterPack": "scripts/electron-builder-after-pack.cjs",
    "artifactBuildStarted": "scripts/electron-builder-after-all-artifact-build.cjs",
    "afterAllArtifactBuild": "scripts/electron-builder-after-all-artifact-build.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "signIgnore": [
        "\\.safetensors$",
        "/Contents/Resources/bundled-node/"
      ],
      "notarize": {
        "teamId": "CCKXS9W488"
      },
      "minimumSystemVersion": "14.5.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MLX Harness uses the microphone when you speak to a model or record a voice sample. The audio stays on this Mac."
      }
    },
    "dmg": {
      "sign": true,
      "writeUpdateInfo": true,
      "background": "build/dmg-background.png",
      "window": {
        "width": 760,
        "height": 460
      },
      "iconSize": 80,
      "contents": [
        {
          "x": 160,
          "y": 220,
          "name": "MLX Harness.app"
        },
        {
          "x": 600,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "MLX Harness ${version}"
    },
    "extraResources": [
      {
        "from": "bundled-python",
        "to": "bundled-python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../vmlx_engine",
        "to": "vmlx-engine-source/vmlx_engine",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../pyproject.toml",
        "to": "vmlx-engine-source/pyproject.toml"
      },
      {
        "from": "resources/bundled-node",
        "to": "bundled-node",
        "filter": [
          "MLX Node.zip",
          "MLX Node.json"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "out/**/*",
      "resources/**/*",
      "!resources/bundled-node{,/**/*}",
      "!**/.DS_Store"
    ],
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "artifactName": "MLX-Harness-${version}-${arch}.${ext}"
  }
}
